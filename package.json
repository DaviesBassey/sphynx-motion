{
  "name": "sphynxplay",
  "version": "1.0.0",
  "private": true,
  "description": "SphynxPlay — African vertical drama streaming PWA + native app",
  "scripts": {
    "start":      "cd server && npm start",
    "predev":     "lsof -ti:${PORT:-3000} | xargs kill -9 2>/dev/null; sleep 0.3; true",
    "dev":        "cd server && npm run dev",
    "build":      "echo 'Static app — no build step required'",
    "lint":       "cd server && npx eslint .",
    "lint:fix":   "cd server && npx eslint . --fix",
    "typecheck":  "cd server && npx tsc --project tsconfig.json",
    "test":       "cd server && node --test test/api.test.js",
    "cap:sync":        "npx cap sync",
    "cap:ios":         "npx cap open ios",
    "cap:android":     "npx cap open android",
    "cap:build:ios":   "npx cap sync ios && npx cap build ios",
    "cap:build:android": "npx cap sync android && npx cap build android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2"
  }
}
