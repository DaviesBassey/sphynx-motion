# ─── Supabase ─────────────────────────────────────────────────────────────────
# Create a free project at https://supabase.com
# Then: Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Cookie secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING

# ─── Public app origin (for CORS) ─────────────────────────────────────────────
PUBLIC_ORIGIN=http://localhost:3000

# ─── Supabase Storage buckets (create these in Supabase dashboard) ─────────────
STORAGE_BUCKET_POSTERS=posters
STORAGE_BUCKET_VIDEOS=videos
STORAGE_BUCKET_TRAILERS=trailers

# ─── Mux video hosting (https://dashboard.mux.com) ────────────────────────────
# Settings → API Access Tokens → Create (Mux Video — Full Access)
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
# Mux Dashboard → Webhooks → create webhook → copy Signing Secret
MUX_WEBHOOK_SECRET=your-mux-webhook-signing-secret

# ─── Stripe payments (https://dashboard.stripe.com) ───────────────────────────
# Developers → API Keys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
# Stripe Dashboard → Products → create Soul Pass and Soul Token products → copy Price IDs
STRIPE_PRICE_SOUL_PASS_MONTHLY=price_your-monthly-price-id
STRIPE_PRICE_SOUL_PASS_YEARLY=price_your-yearly-price-id
# After payment, redirect here (your public app URL)
STRIPE_SUCCESS_URL=http://localhost:3000/?payment=success
STRIPE_CANCEL_URL=http://localhost:3000/?payment=cancelled

# ─── PayFast (https://www.payfast.co.za) — South Africa payments ──────────────
# My Account → Integration → Merchant Details
PAYFAST_MERCHANT_ID=your-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
PAYFAST_PASSPHRASE=your-payfast-passphrase
# Use sandbox for testing: https://sandbox.payfast.co.za
PAYFAST_URL=https://www.payfast.co.za/eng/process
PAYFAST_NOTIFY_URL=https://your-domain.com/api/payments/payfast/itn
PAYFAST_RETURN_URL=https://your-domain.com/?payment=success
PAYFAST_CANCEL_URL=https://your-domain.com/?payment=cancelled

# ─── RevenueCat (https://app.revenuecat.com) — Apple IAP + Google Play ─────────
# Project → API Keys → copy Secret key
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-authorization-header

# ─── Web Push / VAPID (generate once — never change after first subscriber) ────
# Generate with: node -e "const wp=require('web-push');const k=wp.generateVAPIDKeys();console.log(k)"
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=admin@sphynxmotion.com
