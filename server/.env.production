# ─── SPHYNX MOTION — Production Environment ───────────────────────────────────
# Copy this to server/.env on your production server and fill in real values.
# NEVER commit this file with real secrets.

NODE_ENV=production
PORT=3000

# ─── Public origin (your production domain) ───────────────────────────────────
PUBLIC_ORIGIN=https://app.sphynxmotion.com

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# NEVER expose this in frontend code — server-side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Mux (video hosting) ──────────────────────────────────────────────────────
# dashboard.mux.com → Settings → Access Tokens
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
# dashboard.mux.com → Settings → Webhooks → Signing secret
MUX_WEBHOOK_SECRET=your-mux-webhook-secret

# ─── Stripe (web payments) ────────────────────────────────────────────────────
# dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# ─── Storage buckets (create in Supabase dashboard → Storage) ─────────────────
STORAGE_BUCKET_POSTERS=posters
STORAGE_BUCKET_VIDEOS=videos
STORAGE_BUCKET_TRAILERS=trailers

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate: node -e "const wp=require('web-push');const k=wp.generateVAPIDKeys();console.log(k)"
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@sphynxmotion.com

# ─── Sentry (error tracking — optional but recommended) ───────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
